{
	"name": "band-spider",
	"version": "1.0.0",
	"description": "",
	"private": true,
	"type": "commonjs",
	"engines": {
		"node": "^22.13.0 || >=24.11.0"
	},
	"workspaces": [
		"packages/contracts",
		"packages/core",
		"packages/storage-sqlite",
		"packages/cli"
	],
	"scripts": {
		"build": "rm -rf packages/*/dist && tsc -b",
		"db:accounts": "npm run build && node ./packages/cli/dist/index.js --account",
		"db:items": "npm run build && node ./packages/cli/dist/index.js",
		"db:accounts:reverse": "npm run build && node ./packages/cli/dist/index.js --account --reverse",
		"db:items:reverse": "npm run build && node ./packages/cli/dist/index.js --reverse",
		"test": "npm run build && node --test \"packages/*/dist/tests/**/*.test.js\"",
		"superTag": "npm run build && node ./packages/cli/dist/index.js --superTag"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"devDependencies": {
		"@types/cli-color": "2.0.6",
		"@types/node": "26.6.6",
		"typescript": "7.0.2"
	},
	"overrides": {
		"typeorm": {
			"better-sqlite3": "13.0.3"
		}
	}
}
