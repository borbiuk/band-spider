{
	"name": "band-spider",
	"version": "1.0.0",
	"description": "",
	"private": true,
	"main": "dist/index.js",
	"type": "commonjs",
	"engines": {
		"node": "^22.13.0 || >=24.11.0"
	},
	"scripts": {
		"build": "rm -rf dist && tsc",
		"db:accounts": "npm run build && node ./dist/index.js --headless --account",
		"db:items": "npm run build && node ./dist/index.js --headless",
		"db:accounts:browser": "npm run build && node ./dist/index.js --headless --account --browser",
		"db:items:browser": "npm run build && node ./dist/index.js --headless --browser",
		"debug:db:accounts": "npm run build && node ./dist/index.js --account --browser",
		"debug:db:items": "npm run build && node ./dist/index.js --browser",
		"docker:db:accounts": "npm run build && node ./dist/index.js --headless --account --docker --browser",
		"docker:db:items": "npm run build && node ./dist/index.js --headless --docker --browser",
		"test": "npm run build && node --test dist/tests/",
		"superTag": "npm run build && node ./dist/index.js --superTag",
		"install-browser": "npx @puppeteer/browsers install chrome@stable"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"dependencies": {
		"better-sqlite3": "13.0.3",
		"cheerio": "1.1.2",
		"cli-color": "2.0.4",
		"fuse.js": "7.5.0",
		"pino": "10.4.0",
		"pino-pretty": "13.2.0",
		"puppeteer": "25.16.0",
		"puppeteer-extra": "3.3.6",
		"puppeteer-extra-plugin-stealth": "2.11.2",
		"reflect-metadata": "0.2.2",
		"typeorm": "1.1.2"
	},
	"devDependencies": {
		"@types/cli-color": "2.0.6",
		"@types/node": "26.6.6",
		"typescript": "7.0.2"
	},
	"overrides": {
		"typeorm": {
			"better-sqlite3": "$better-sqlite3"
		}
	}
}
